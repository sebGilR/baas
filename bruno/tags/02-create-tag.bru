meta {
  name: 02 - Create Tag
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

body:json {
  {
    "data": {
      "type": "tags",
      "attributes": {
        "name": "Technology",
        "slug": "technology"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("tag_id", res.getBody().data.id);
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response is JSON:API format", function() {
    expect(res.getBody()).to.have.property('data');
  });
  
  test("Tag has name", function() {
    const body = res.getBody();
    expect(body.data.attributes.name).to.equal("Technology");
  });
  
  test("Tag has slug", function() {
    const body = res.getBody();
    expect(body.data.attributes.slug).to.equal("technology");
  });
  
  test("Tag has public_id, not integer id", function() {
    const body = res.getBody();
    expect(body.data.id).to.match(/^[0-9a-f-]{36}$/);
  });
}
