meta {
  name: 04 - Update Tag
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/tags/{{tag_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

body:json {
  {
    "data": {
      "type": "tags",
      "id": "{{tag_id}}",
      "attributes": {
        "name": "Tech & Innovation",
        "slug": "tech-innovation"
      }
    }
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response is JSON:API format", function() {
    expect(res.getBody()).to.have.property('data');
  });
  
  test("Tag name is updated", function() {
    const body = res.getBody();
    expect(body.data.attributes.name).to.equal("Tech & Innovation");
  });
  
  test("Tag slug is updated", function() {
    const body = res.getBody();
    expect(body.data.attributes.slug).to.equal("tech-innovation");
  });
}
