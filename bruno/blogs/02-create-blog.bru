meta {
  name: 02 - Create Blog
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/blogs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "data": {
      "type": "blogs",
      "attributes": {
        "name": "My Tech Blog",
        "description": "A blog about technology and software development",
        "settings": {
          "theme": "dark",
          "posts_per_page": 10
        }
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("blog_id", body.data.id);
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains blog data", function() {
    expect(res.getBody().data).to.have.property('id');
    expect(res.getBody().data.attributes.name).to.equal("My Tech Blog");
  });
  
  test("Blog has generated slug", function() {
    expect(res.getBody().data.attributes.slug).to.equal("my-tech-blog");
  });
  
  test("Blog status is active", function() {
    expect(res.getBody().data.attributes.status).to.equal("active");
  });
}
