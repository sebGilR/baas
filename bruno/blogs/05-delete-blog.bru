meta {
  name: 05 - Delete Blog
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/api/v1/blogs/{{blog_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

tests {
  test("Status is 204 No Content", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
