meta {
  name: 03 - Get Blog
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/blogs/{{blog_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

params:query {
  ~include: posts
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains blog data", function() {
    expect(res.getBody().data).to.have.property('id');
    expect(res.getBody().data.type).to.equal("blog");
  });
  
  test("Blog has expected attributes", function() {
    const attrs = res.getBody().data.attributes;
    expect(attrs).to.have.property('name');
    expect(attrs).to.have.property('slug');
    expect(attrs).to.have.property('description');
    expect(attrs).to.have.property('status');
    expect(attrs).to.have.property('post_count');
  });
}
