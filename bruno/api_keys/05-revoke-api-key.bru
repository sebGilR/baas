meta {
  name: 05 - Revoke API Key
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/api_keys/{{api_key_id}}/revoke
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("API key is revoked", function() {
    const body = res.getBody();
    expect(body.data.attributes.status).to.equal("revoked");
  });
}
