meta {
  name: 06 - Unpublish Post
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/posts/{{post_id}}/unpublish
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response is JSON:API format", function() {
    expect(res.getBody()).to.have.property('data');
  });
  
  test("Post status is draft", function() {
    const body = res.getBody();
    expect(body.data.attributes.status).to.equal('draft');
  });
  
  test("Post has public_id, not integer id", function() {
    const body = res.getBody();
    expect(body.data.id).to.match(/^[0-9a-f-]{36}$/);
  });
}
