meta {
  name: 04 - Update Draft
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/drafts/{{draft_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

body:json {
  {
    "data": {
      "type": "drafts",
      "id": "{{draft_id}}",
      "attributes": {
        "title": "Updated Draft Title",
        "content": "This is the updated draft content with more details and improvements."
      }
    }
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response is JSON:API format", function() {
    expect(res.getBody()).to.have.property('data');
  });
  
  test("Draft title is updated", function() {
    const body = res.getBody();
    expect(body.data.attributes.title).to.equal("Updated Draft Title");
  });
  
  test("Draft version is incremented", function() {
    const body = res.getBody();
    expect(body.data.attributes.version).to.be.greaterThan(1);
  });
}
