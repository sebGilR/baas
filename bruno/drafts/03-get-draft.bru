meta {
  name: 03 - Get Draft
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/drafts/{{draft_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: ApiKey {{api_key_token}}
}

params:query {
  ~include: post
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response is JSON:API format", function() {
    expect(res.getBody()).to.have.property('data');
  });
  
  test("Draft has correct type", function() {
    const body = res.getBody();
    expect(body.data.type).to.equal('drafts');
  });
  
  test("Draft has expected attributes", function() {
    const attrs = res.getBody().data.attributes;
    expect(attrs).to.have.property('title');
    expect(attrs).to.have.property('content');
    expect(attrs).to.have.property('version');
  });
}
